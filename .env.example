# Copy to .env and fill in. NEVER commit .env.
# (Spring reads these as environment variables; docker-compose reads them for the MySQL container.)

DB_USERNAME=voting_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional: creates the first admin on startup (password must be 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
